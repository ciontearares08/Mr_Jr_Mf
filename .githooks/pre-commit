#!/bin/sh
# Lints staged files before each commit. Checks whose tools aren't installed in the
# current environment are skipped (CI still runs them). Enabled with `make hooks`,
# which the devcontainers run on start. Bypass once with `git commit --no-verify`.

root=$(git rev-parse --show-toplevel)
staged=$(git diff --cached --name-only --diff-filter=ACMR)
fail=0

api_files=$(echo "$staged" | grep '^apps/api/.*\.py$' | sed 's|^apps/api/||')
if [ -n "$api_files" ]; then
  if command -v uv >/dev/null 2>&1; then
    echo "pre-commit: ruff on staged api files"
    (cd "$root/apps/api" && uv run --quiet ruff check $api_files && uv run --quiet ruff format --check $api_files) || fail=1
  else
    echo "pre-commit: uv not found, skipping api checks (CI will run them)"
  fi
fi

web_files=$(echo "$staged" | grep -E '^apps/web/.*\.(ts|tsx|js|jsx)$' | sed 's|^apps/web/||')
if [ -n "$web_files" ]; then
  if [ -x "$root/apps/web/node_modules/.bin/eslint" ]; then
    echo "pre-commit: eslint on staged web files"
    (cd "$root/apps/web" && npx --no-install eslint $web_files) || fail=1
  else
    echo "pre-commit: eslint not installed here, skipping web checks (CI will run them)"
  fi
fi

if [ "$fail" -ne 0 ]; then
  echo
  echo "pre-commit: commit blocked. Fix the issues above (make api-format fixes most ruff errors)."
  exit 1
fi
