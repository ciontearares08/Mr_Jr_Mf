#!/bin/sh
# Lints staged api, sim and web files before each commit. Checks whose tools aren't
# installed in the current environment are skipped (CI still runs them). Enabled with
# `make hooks`, which the devcontainers run on start. Bypass once with `git commit --no-verify`.

root=$(git rev-parse --show-toplevel)
staged=$(git diff --cached --name-only --diff-filter=ACMR)
fail=0

# Runs ruff on the staged Python files of one app, for example "api" or "sim".
check_python_app() {
  app=$1
  files=$(echo "$staged" | grep "^apps/$app/.*\.py$" | sed "s|^apps/$app/||")
  [ -z "$files" ] && return
  ruff="$root/apps/$app/.venv/bin/ruff"
  if [ -x "$ruff" ]; then
    echo "pre-commit: ruff on staged $app files"
    (cd "$root/apps/$app" && "$ruff" check $files && "$ruff" format --check $files) || fail=1
  else
    echo "pre-commit: ruff not installed for $app here, skipping (CI will run it)"
  fi
}

check_python_app api
check_python_app sim

web_files=$(echo "$staged" | grep -E '^apps/web/.*\.(ts|tsx|js|jsx)$' | sed 's|^apps/web/||')
if [ -n "$web_files" ]; then
  if [ -x "$root/apps/web/node_modules/.bin/eslint" ]; then
    echo "pre-commit: eslint on staged web files"
    (cd "$root/apps/web" && npx --no-install eslint $web_files) || fail=1
  else
    echo "pre-commit: eslint not installed here, skipping web checks (CI will run them)"
  fi
fi

if [ "$fail" -ne 0 ]; then
  echo
  echo "pre-commit: commit blocked. Fix the issues above (make api-format or make sim-format fixes most ruff errors)."
  exit 1
fi
