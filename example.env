# Generate a secret with this command, in any devcontainer or on a host with Python:
# python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Allows make db-seed, make db-fresh and the other dev-only database tools.
# Leave it out on any server that has real data.
APP_ENV=development

# The refresh token cookie is Secure, so browsers only keep it on https and on
# localhost. If your browser drops the cookie on http://localhost, set this to false.
# Keep it true on every server.
REFRESH_COOKIE_SECURE=true
